    { "level": "BEGINNER", "unit": 1, "titleKo": "인사와 안부", "titleEn": "Greetings and small talk", "items": [
      {"id": "day.b1.01", "skill": "VOCAB", "promptKo": "‘고향’을 영어로 말해 보세요.", "promptEn": null, "answers": ["hometown", "home town"], "keywords": ["hometown"], "hintWord": "hometown", "meaningKo": "고향", "explanationKo": "고향을 물을 땐 Where's your hometown?이라고 해요.", "maxLoad": "NORMAL", "tags": ["greeting"], "distractors": ["homework", "downtown", "household"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b1.02", "skill": "EXPRESSION", "promptKo": "친구에게 가볍게 안부를 물을 때?", "promptEn": null, "answers": ["How's it going?", "How are you doing?", "How have you been?"], "keywords": ["how"], "hintWord": "going", "meaningKo": "잘 지내요?", "explanationKo": "How's it going?은 가볍게 안부를 묻는 인사예요.", "maxLoad": "NORMAL", "tags": ["greeting"], "distractors": ["How's it go?", "How do you going?"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b1.03", "skill": "SENTENCE_BUILD", "promptKo": "‘저도 만나서 반가워요.’를 영어로 말해 보세요.", "promptEn": null, "answers": ["Nice to meet you, too.", "It's nice to meet you, too.", "Nice meeting you, too."], "keywords": ["nice", "meet", "too"], "hintWord": "too", "meaningKo": "저도 만나서 반가워요.", "explanationKo": "상대가 먼저 인사하면 too를 붙여 답해요.", "maxLoad": "NORMAL", "tags": ["greeting"], "distractors": ["Nice to meet you, either.", "Me too nice to meet you."], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b1.04", "skill": "VOCAB", "promptKo": "‘취미’는 영어로 뭐라고 할까요?", "promptEn": null, "answers": ["hobby", "pastime"], "keywords": ["hobby"], "hintWord": "hobby", "meaningKo": "취미", "explanationKo": "취미는 What do you do for fun?으로도 물어요.", "maxLoad": "NORMAL", "tags": ["greeting"], "distractors": ["habit", "lobby", "happy"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b1.05", "skill": "EXPRESSION", "promptKo": "오랜만에 만난 친구에게 인사할 때?", "promptEn": null, "answers": ["Long time no see.", "It's been a long time.", "It has been a long time."], "keywords": ["long", "time"], "hintWord": "long", "meaningKo": "오랜만이에요.", "explanationKo": "오랜만에 만난 사람에게 쓰는 인사예요.", "maxLoad": "NORMAL", "tags": ["greeting"], "distractors": ["Long time no saw.", "Long no time see."], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b1.06", "skill": "SENTENCE_BUILD", "promptKo": "‘쉴 때 주로 뭐 하세요?’를 영어로 말해 보세요.", "promptEn": null, "answers": ["What do you do for fun?", "What do you like to do for fun?", "What do you usually do for fun?"], "keywords": ["do", "fun"], "hintWord": "fun", "meaningKo": "쉴 때 주로 뭐 하세요?", "explanationKo": "취미를 물을 때 hobby보다 자연스러운 질문이에요.", "maxLoad": "NORMAL", "tags": ["greeting"], "distractors": ["What do you do for funny?", "What are you do for fun?"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b1.07", "skill": "VOCAB", "promptKo": "‘소개하다’, 영어 한 단어로 말해 보세요.", "promptEn": null, "answers": ["introduce", "present"], "keywords": ["introduce"], "hintWord": "introduce", "meaningKo": "소개하다", "explanationKo": "‘제 소개를 할게요’는 Let me introduce myself.예요.", "maxLoad": "NORMAL", "tags": ["greeting"], "distractors": ["produce", "reduce", "include"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b1.08", "skill": "SENTENCE_BUILD", "promptKo": "‘어디 출신이세요?’를 영어로 말해 보세요.", "promptEn": null, "answers": ["Where are you from?", "Where do you come from?", "Where are you from originally?"], "keywords": ["where", "from"], "hintWord": "from", "meaningKo": "어디 출신이세요?", "explanationKo": "from으로 끝나는 질문이에요.", "maxLoad": "NORMAL", "tags": ["greeting"], "distractors": ["Where are you come from?", "Where do you from?"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b1.09", "skill": "LISTEN_REPEAT", "promptKo": "듣고 따라 말해 보세요.", "promptEn": "It was nice talking to you.", "answers": ["It was nice talking to you."], "keywords": ["nice", "talk"], "hintWord": "talking", "meaningKo": "얘기 나눠서 즐거웠어요.", "explanationKo": "대화를 마칠 때 쓰는 인사예요.", "maxLoad": "NORMAL", "tags": ["greeting"], "distractors": [], "contextHook": null, "minWords": 0, "listenSec": 10, "contrast": null, "pronFocus": null},
