      {"id": "day.b3.03", "skill": "VOCAB", "promptKo": "‘교통, 차량 흐름’은 영어로 뭐라고 할까요?", "promptEn": null, "answers": ["traffic", "traffic jam"], "keywords": ["traffic"], "hintWord": "traffic", "meaningKo": "교통, 차량 흐름", "explanationKo": "차가 많이 막힐 땐 heavy traffic이라고 해요.", "maxLoad": "NORMAL", "tags": ["weather", "commute"], "distractors": ["graphic", "terrific", "tragic"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b3.04", "skill": "SENTENCE_BUILD", "promptKo": "‘비가 올 것 같아요.’를 영어로 말해 보세요.", "promptEn": null, "answers": ["It looks like rain.", "It looks like it's going to rain.", "It might rain later."], "keywords": ["rain"], "hintWord": "looks", "meaningKo": "비가 올 것 같아요.", "explanationKo": "look like + 명사는 ‘~일 것 같다’예요.", "maxLoad": "NORMAL", "tags": ["weather", "commute"], "distractors": ["It looks rain.", "It looks like raining."], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
