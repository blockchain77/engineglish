    ] },
    { "level": "BEGINNER", "unit": 2, "titleKo": "시간과 약속", "titleEn": "Time and plans", "items": [
      {"id": "day.b2.01", "skill": "VOCAB", "promptKo": "‘약속, 예약(병원 등)’을 영어로 말해 보세요.", "promptEn": null, "answers": ["appointment", "booking"], "keywords": ["appointment"], "hintWord": "appointment", "meaningKo": "약속, 예약(병원 등)", "explanationKo": "친구와의 약속은 plans, 병원 예약은 appointment예요.", "maxLoad": "NORMAL", "tags": ["plan", "time"], "distractors": ["apartment", "department", "disappointment"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b2.02", "skill": "EXPRESSION", "promptKo": "약속에 늦을 것 같을 때 한마디?", "promptEn": null, "answers": ["I'm running late.", "I'm running a little late.", "I'm going to be late."], "keywords": ["late"], "hintWord": "running", "meaningKo": "좀 늦을 것 같아요.", "explanationKo": "run late는 ‘예정보다 늦어지다’라는 뜻이에요.", "maxLoad": "NORMAL", "tags": ["plan", "time"], "distractors": ["I'm running fast.", "I'm late running."], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b2.03", "skill": "VOCAB", "promptKo": "‘평일’은 영어로 뭐라고 할까요?", "promptEn": null, "answers": ["weekday", "workday"], "keywords": ["weekday"], "hintWord": "weekday", "meaningKo": "평일", "explanationKo": "주말은 weekend, 평일은 weekday예요.", "maxLoad": "NORMAL", "tags": ["plan", "time"], "distractors": ["weekend", "birthday", "holiday"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b2.04", "skill": "SENTENCE_BUILD", "promptKo": "‘이번 주말에 뭐 해요?’를 영어로 말해 보세요.", "promptEn": null, "answers": ["What are you doing this weekend?", "What are your plans for this weekend?", "Any plans for this weekend?"], "keywords": ["weekend"], "hintWord": "weekend", "meaningKo": "이번 주말에 뭐 해요?", "explanationKo": "가까운 미래 계획은 현재진행형으로도 물어요.", "maxLoad": "NORMAL", "tags": ["plan", "time"], "distractors": ["What do you doing this weekend?", "What are you doing at this weekend?"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b2.05", "skill": "EXPRESSION", "promptKo": "친구에게 간단히 뭐 먹자고 할 때?", "promptEn": null, "answers": ["Let's grab a bite.", "Let's grab a bite to eat.", "Let's grab something to eat."], "keywords": ["grab"], "hintWord": "bite", "meaningKo": "간단히 뭐 좀 먹어요.", "explanationKo": "grab a bite는 ‘간단히 먹다’라는 뜻이에요.", "maxLoad": "NORMAL", "tags": ["plan", "time"], "distractors": ["Let's grab a bike.", "Let's bite a grab."], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b2.06", "skill": "VOCAB", "promptKo": "‘취소하다’, 영어 한 단어로 말해 보세요.", "promptEn": null, "answers": ["cancel", "call off"], "keywords": ["cancel"], "hintWord": "cancel", "meaningKo": "취소하다", "explanationKo": "call off는 ‘약속이나 행사를 취소하다’예요.", "maxLoad": "NORMAL", "tags": ["plan", "time"], "distractors": ["council", "channel", "counsel"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b2.07", "skill": "SENTENCE_BUILD", "promptKo": "‘대신 일곱 시에 만날 수 있을까요?’를 영어로 말해 보세요.", "promptEn": null, "answers": ["Can we meet at seven instead?", "Could we meet at seven instead?", "How about meeting at seven instead?"], "keywords": ["meet", "seven", "instead"], "hintWord": "instead", "meaningKo": "대신 일곱 시에 만날 수 있을까요?", "explanationKo": "instead는 ‘대신에’라는 뜻이에요.", "maxLoad": "NORMAL", "tags": ["plan", "time"], "distractors": ["Can we meet on seven instead?", "Can we meet at seven instead of?"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b2.08", "skill": "SENTENCE_BUILD", "promptKo": "‘10분 안에 도착해요.’를 영어로 말해 보세요.", "promptEn": null, "answers": ["I'll be there in ten minutes.", "I will be there in ten minutes.", "I'll get there in ten minutes."], "keywords": ["there", "ten", "minute"], "hintWord": "minutes", "meaningKo": "10분 안에 도착해요.", "explanationKo": "in ten minutes는 ‘10분 뒤에’라는 뜻이에요.", "maxLoad": "NORMAL", "tags": ["plan", "time"], "distractors": ["I'll be there after ten minutes.", "I'll be there for ten minutes."], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
