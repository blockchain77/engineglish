      {"id": "day.b3.06", "skill": "VOCAB", "promptKo": "‘습한, 후덥지근한’, 영어 한 단어로 말해 보세요.", "promptEn": null, "answers": ["humid", "muggy"], "keywords": ["humid"], "hintWord": "humid", "meaningKo": "습한, 후덥지근한", "explanationKo": "여름 날씨를 말할 때 자주 써요.", "maxLoad": "NORMAL", "tags": ["weather", "commute"], "distractors": ["human", "humble", "timid"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b3.07", "skill": "SENTENCE_BUILD", "promptKo": "‘출퇴근 시간이 얼마나 걸려요?’를 영어로 말해 보세요.", "promptEn": null, "answers": ["How long is your commute?", "How long does your commute take?", "How long does your commute usually take?"], "keywords": ["long", "commute"], "hintWord": "commute", "meaningKo": "출퇴근 시간이 얼마나 걸려요?", "explanationKo": "How long은 걸리는 시간을 물을 때 써요.", "maxLoad": "NORMAL", "tags": ["weather", "commute"], "distractors": ["How long is your commute take?", "How much is your commute?"], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
      {"id": "day.b3.08", "skill": "SENTENCE_BUILD", "promptKo": "‘저는 보통 지하철로 출근해요.’를 영어로 말해 보세요.", "promptEn": null, "answers": ["I usually take the subway to work.", "I usually go to work by subway.", "I normally take the subway to work."], "keywords": ["subway", "work"], "hintWord": "subway", "meaningKo": "저는 보통 지하철로 출근해요.", "explanationKo": "take the subway는 ‘지하철을 타다’예요.", "maxLoad": "NORMAL", "tags": ["weather", "commute"], "distractors": ["I usually take subway to work.", "I usually ride the subway on work."], "contextHook": null, "minWords": 0, "listenSec": null, "contrast": null, "pronFocus": null},
